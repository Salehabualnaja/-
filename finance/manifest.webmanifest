{
  "id": "./?app=mizan",
  "name": "الميزان — مصاريفي ومستحقاتي",
  "short_name": "الميزان",
  "description": "تطبيق شخصي لحساب المصاريف وتصنيفها، والمستحقات القادمة، وقراءة رسائل البنوك — لحساباتك الشخصية وحساب الشركة.",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0F1412",
  "theme_color": "#0F1412",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "لصق رسالة بنكية", "short_name": "رسالة", "url": "./?action=sms", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "عملية جديدة", "short_name": "عملية", "url": "./?action=add", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "المستحقات", "short_name": "المستحقات", "url": "./?view=dues", "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

# MINDSPACE environment
#
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DIR.
# Set it to use a real PostgreSQL server (see docker-compose.yml):
# DATABASE_URL=postgres://mindspace:mindspace@localhost:5432/mindspace
DATABASE_URL=

# Folder for the embedded database when DATABASE_URL is empty.
PGLITE_DIR=./.data/pglite

# Optional AI provider (Phase 5). The app runs fully without it.
# Keys are read on the server only and never sent to the browser.
AI_PROVIDER=
ANTHROPIC_API_KEY=
